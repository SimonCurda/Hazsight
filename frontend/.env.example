# Hazsight Frontend Environment Variables (Next.js)
# Copy this file to .env.local and fill in real values.

# Nebius Token Factory API key — get one at https://tokenfactory.nebius.com
# Join the Nebius Builder Program for hackathon credits (Token Factory + Tavily + Academy).
# If this is not set, the app falls back to mock data so the demo still works.
NEBIUS_API_KEY=

# Nebius Token Factory base URL (OpenAI-compatible endpoint).
# Default is the public serverless endpoint.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# NVIDIA open-source models served on Nebius Token Factory.
# Verify exact model names in the Token Factory playground once you have an API key.
NEBIUS_REASONING_MODEL=nvidia/nemotron-3-ultra
NEBIUS_FAST_MODEL=nvidia/nemotron-3-super
NEBIUS_VLM_MODEL=meta/llama-3.2-11b-vision-instruct

# URL of the Python backend (FastAPI) — used only for advanced features like
# video stream analysis. For the hackathon demo, the Next.js API routes call
# Nebius Token Factory directly, so this is optional.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Database URL for Prisma (used by the Next.js frontend for future persistence).
DATABASE_URL="file:./db/custom.db"
