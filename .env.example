# Hazsight Frontend Environment Variables (Next.js)
# Copy this file to .env.local and fill in real values.

# Nebius Token Factory API key — get one at https://tokenfactory.nebius.com
# Join the Nebius Builder Program for hackathon credits (Token Factory + Tavily + Academy).
# If this is not set, the app falls back to mock data so the demo still works.
#
# LOCAL DEVELOPMENT:
#   Add the key to .env.local (create this file, it's gitignored):
#     NEBIUS_API_KEY=xxxxxxxxxxxxxxxx
#
# VERCEL DEPLOYMENT:
#   Add the env var in the Vercel dashboard:
#     Project Settings → Environment Variables → Add
#       Key:   NEBIUS_API_KEY
#       Value: xxxxxxxxxxxxxxxx
#       Environments: Production + Preview + Development (all)
#   Or via Vercel CLI:
#     vercel env add NEBIUS_API_KEY
#
# VERIFY THE KEY:
#   After setting it, visit /api/nebius-test — makes a minimal test request
#   to confirm the key + endpoint + model names work before deploying.
NEBIUS_API_KEY=

# Nebius Token Factory base URL (OpenAI-compatible endpoint).
# Default is the public serverless endpoint.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# NVIDIA open-source models served on Nebius Token Factory.
# Verify exact model names in the Token Factory playground once you have an API key.
NEBIUS_REASONING_MODEL=nvidia/nemotron-3-ultra
NEBIUS_FAST_MODEL=nvidia/nemotron-3-super
NEBIUS_VLM_MODEL=meta/llama-3.2-11b-vision-instruct

# URL of the Python backend (FastAPI) — used only for advanced features like
# video stream analysis. For the hackathon demo, the Next.js API routes call
# Nebius Token Factory directly, so this is optional.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Tavily API key — for live web search of safety regulations.
# Get your key at: https://tavily.com (free tier available)
# If not set, the app uses pre-written mock regulation citations.
#
# LOCAL DEVELOPMENT:
#   Add the key to .env.local (create this file, it's gitignored):
#     TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxx
#
# VERCEL DEPLOYMENT:
#   Add the env var in the Vercel dashboard:
#     Project Settings → Environment Variables → Add
#       Key:   TAVILY_API_KEY
#       Value: tvly-xxxxxxxxxxxxxxxxxxxx
#       Environments: Production + Preview + Development (all)
#   Or via Vercel CLI:
#     vercel env add TAVILY_API_KEY
#
# VERIFY THE KEY:
#   After setting it, visit /api/tavily-test — returns a sample search
#   to confirm the key works before deploying.
TAVILY_API_KEY=

# Database URL for Prisma (used by the Next.js frontend for future persistence).
DATABASE_URL="file:./db/custom.db"
