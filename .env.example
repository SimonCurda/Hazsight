# ==============================================================================
# Hazsight Environment Configuration
# ==============================================================================

# NVIDIA NIM / API Catalog Configuration
# Get your API key at: https://build.nvidia.com
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
# Alternative NVIDIA Models:
# - nvidia/vila-1.5
# - nvidia/cosmos-nemotron-34b
# - meta/llama-3.2-90b-vision-instruct

# Application Settings
APP_ENV=development
LOG_LEVEL=INFO

# Stream & Camera Settings
DEFAULT_CAMERA_SOURCE=0 # 0 for default webcam, or rtsp://... or path/to/video.mp4
FRAME_SAMPLE_INTERVAL_SECONDS=1.0 # Process 1 frame per second to optimize API usage
MOTION_DETECTION_ENABLED=true

# Alerting Thresholds
MIN_ALERT_SEVERITY=HIGH # LOW, MEDIUM, HIGH, CRITICAL
ALERT_COOLDOWN_SECONDS=30 # Prevent spamming alerts for persistent issues

# Storage & Output Paths
DATA_DIR=./data
INCIDENTS_DIR=./data/incidents
REPORTS_DIR=./data/reports
