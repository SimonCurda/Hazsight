# ==============================================================================
# Hazsight Environment Configuration
# ==============================================================================
# Hackathon compliance:
#   "All submissions must run on either Nebius Token Factory or Nebius AI Cloud
#    and use at least one NVIDIA open source model."
#
# Nebius Token Factory serves NVIDIA Nemotron open-source models
# (Nemotron 3 Ultra for reasoning, Nemotron 3 Super for fast calls,
# plus VLMs like Llama 3.2 Vision) via an OpenAI-compatible API at
# https://api.tokenfactory.nebius.com/v1/
# ==============================================================================

# Nebius Token Factory Configuration
# Get your API key at: https://tokenfactory.nebius.com
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# NVIDIA Nemotron open-source models served on Nebius Token Factory
# Nemotron 3 Ultra = deep reasoning (hazard classification, severity, recommendations)
NEBIUS_REASONING_MODEL=nvidia/nemotron-3-ultra
# Nemotron 3 Super = fast everyday calls (chat Q&A, quick lookups)
NEBIUS_FAST_MODEL=nvidia/nemotron-3-super
# VLM for image analysis — verify exact name in Token Factory playground
# (https://tokenfactory.nebius.com) once you have an API key.
# Alternatives on Nebius Token Factory (verify availability):
# - nvidia/vila-1.5
# - nvidia/nemotron-vision
# - meta/llama-3.2-90b-vision-instruct
NEBIUS_VLM_MODEL=meta/llama-3.2-11b-vision-instruct

# Application Settings
APP_ENV=development
LOG_LEVEL=INFO

# Stream & Camera Settings
DEFAULT_CAMERA_SOURCE=0 # 0 for default webcam, or rtsp://... or path/to/video.mp4
FRAME_SAMPLE_INTERVAL_SECONDS=1.0 # Process 1 frame per second to optimize API usage
MOTION_DETECTION_ENABLED=true

# Alerting Thresholds
MIN_ALERT_SEVERITY=HIGH # LOW, MEDIUM, HIGH, CRITICAL
ALERT_COOLDOWN_SECONDS=30 # Prevent spamming alerts for persistent issues

# Storage & Output Paths
DATA_DIR=./data
INCIDENTS_DIR=./data/incidents
REPORTS_DIR=./data/reports
